<?xml version="1.0" encoding="utf-8"?>
<!-- A home server (ProjectServer) on the local Wi-Fi is reached over plain HTTP at an address the user
     enters, so cleartext is allowed; everything else the app uses (the online service, Steam) is HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
